# Node.js dependencies
# These will be installed fresh in the container
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm

# Next.js build output
# Will be generated during Docker build
.next
.next/
out/
build/

# Testing
coverage/
*.test.ts
*.test.tsx
*.spec.ts
*.spec.tsx
__tests__/
**/__tests__/**
**/*.test.*

# Development files
.env*.local
.env.development.local
.env.test.local
.env.production.local
*.log
env/

# IDE and Editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
*.pem

# Git files
.git
.gitignore
.gitattributes

# Documentation (not needed in runtime)
README.md
CHANGELOG.md
LICENSE
*.md
!DOCKER-GUIDE.md

# Docker files (don't need Docker inside Docker)
Dockerfile*
docker-compose*.yml
.dockerignore

# CI/CD
.github/
.gitlab-ci.yml
.travis.yml
azure-pipelines.yml

# Misc
.cache/
.temp/
.tmp/
*.pid
*.seed
*.pid.lock
